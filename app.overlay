&pinctrl {
    i2c1_default: i2c1_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
                    <NRF_PSEL(TWIM_SCL, 0, 5)>;
            bias-pull-up;
        };
    };
    i2c1_sleep: i2c1_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
                    <NRF_PSEL(TWIM_SCL, 0, 5)>;
            low-power-enable;
        };
    };
	i2s0_default_alt: i2s0_default_alt {
		group1 {
			psels = <NRF_PSEL(I2S_SCK_M, 0, 3)>,    /* BCLK -> D1/P0.03 */
				<NRF_PSEL(I2S_LRCK_M, 0, 2)>,   /* LRCK -> D0/P0.02 */
				<NRF_PSEL(I2S_SDOUT, 0, 28)>;   /* DIN  -> D2/P0.28 */
		};
	};

	/* microSD over SPIM2 -- NOT SPIM1, which shares the HW block with the
	 * PPG's I2C1; SPIM2 stays conflict-free for the integrated build.
	 * Proven pinout from spkr_test/app.overlay (works on this hardware). */
	spi2_default_alt: spi2_default_alt {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,    /* CLK  -> D8/P1.13 */
				<NRF_PSEL(SPIM_MOSI, 1, 15)>,   /* MOSI -> D10/P1.15 */
				<NRF_PSEL(SPIM_MISO, 1, 14)>;   /* MISO -> D9/P1.14 */
		};
	};
	spi2_sleep_alt: spi2_sleep_alt {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
				<NRF_PSEL(SPIM_MOSI, 1, 15)>,
				<NRF_PSEL(SPIM_MISO, 1, 14)>;
			low-power-enable;
		};
	};
};

/* microSD card slot on SPIM2 (FAT). PRIMARY future role: WRITING/recording
 * audio to SD; the only read path today is the TEST-ONLY WAV playback. */
&spi2 {
	status = "okay";
	pinctrl-0 = <&spi2_default_alt>;
	pinctrl-1 = <&spi2_sleep_alt>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 29 GPIO_ACTIVE_LOW>;   /* CS -> D3/P0.29 */

	sdhc0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <8000000>;        /* [UNIT] 8 MHz -- safe for SPI SD */
		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

&i2c1 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    pinctrl-0 = <&i2c1_default>;
    pinctrl-1 = <&i2c1_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;

    max30102: max30102@57 {
        compatible = "maxim,max30101";
        reg = <0x57>;
        label = "MAX30102";
    };
};

&i2s0 {
	status = "okay";
	pinctrl-0 = <&i2s0_default_alt>;
	pinctrl-names = "default";
};

/* Onboard PDM mic (MSM261D3526H1CPM): power regulator on P1.10 + enable pdm0.
 * Board DTS already provides the pdm0 node + pdm0_default/sleep pinctrl. */
/ {
    msm261d3526hicpm-c-en {
        compatible = "regulator-fixed";
        regulator-name = "MSM261D3526HICPM-C-EN";
        enable-gpios = <&gpio1 10 (NRF_GPIO_DRIVE_S0H1 | GPIO_ACTIVE_HIGH)>;
        regulator-boot-on;
    };
};

&pdm0 {
    status = "okay";
    clock-source = "PCLK32M";
};

/ {
    aliases {
        dmic0 = &pdm0;   /* mic_vad references DT_ALIAS(dmic0) */
    };
};

