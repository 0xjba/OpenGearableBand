/*
 * SSD1306 0.91" (128x32) OLED on the XIAO header I2C bus (xiao_i2c = i2c22,
 * SDA = D9/P1.05, SCL = D10/P1.06). Same as the M1 bring-up overlay.
 * concat-buf-size for the framebuffer write lives in the board dtsi.
 */

/ {
	chosen {
		zephyr,display = &ssd1306;
	};
};

&xiao_i2c {
	status = "okay";

	ssd1306: ssd1306@3c {
		compatible = "solomon,ssd1306fb";
		reg = <0x3c>;
		width = <128>;
		height = <32>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <31>;
		segment-remap;
		com-invdir;
		com-sequential;
		prechargep = <0x22>;
	};
};
