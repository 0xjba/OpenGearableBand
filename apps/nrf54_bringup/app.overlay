/*
 * SSD1306 0.91" (128x32) OLED on the XIAO header I2C bus (xiao_i2c = i2c22,
 * SDA = D9/P1.05, SCL = D10/P1.06 -- remapped for neat right-edge wiring).
 * Standard 128x32 SSD1306 timing values.
 * VERIFY on HW: I2C address (0x3C vs 0x3D) and geometry (128x32 vs 128x64).
 */

/ {
	chosen {
		zephyr,display = &ssd1306;
	};
};

&xiao_i2c {
	status = "okay";
	/* concat-buf-size for the framebuffer write lives in the board dtsi. */

	ssd1306: ssd1306@3c {
		compatible = "solomon,ssd1306fb";
		reg = <0x3c>;
		width = <128>;
		height = <32>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <31>;   /* height - 1 */
		segment-remap;
		com-invdir;
		com-sequential;           /* 128x32 uses sequential COM pins */
		prechargep = <0x22>;
	};
};
