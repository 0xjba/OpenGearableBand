/*
 * Only the hardware WE added: an external LilyPad button, P1.00 -> GND.
 *
 * Everything else -- LEDs, nPM1300 PMIC, charger (incl. charging-enable),
 * regulators, IMU, mic, watchdog -- comes from Seeed's OFFICIAL board
 * definition in boards/seeed/xiao_nrf54lm20a/, fetched verbatim from
 * github.com/Seeed-Studio/platform-seeedboards. No PMIC or charger value in
 * this project is ours.
 *
 * The previous hand-written board definition declared NO PMIC at all, so
 * nothing ever set `charging-enable` and the battery was never charged.
 */
#include <zephyr/dt-bindings/input/input-event-codes.h>

/*
 * OUR CELL: 120 mAh LiPo. Seeed's board defaults are sized for a bigger cell,
 * so the two cell-dependent values are overridden here -- everything else in
 * the charger node stays Seeed's. Ranges from the binding
 * (zephyr/dts/bindings/sensor/nordic,npm1300-charger.yaml):
 *   current-microamp      32-800 mA in 2 mA steps
 *   dischg-limit-microamp 200 mA or 1000 mA only
 *
 * current-microamp = 60 mA (0.5C). Seeed's 150 mA is 1.25C for this cell --
 *   above the 1C max typical small-LiPo datasheets give. 0.5C is the usual
 *   "standard charge" rate; chosen over 1C because the device is left charging
 *   unattended and the board has NO cell-temperature sensor: the nPM1300 NTC
 *   pin goes to R6, a fixed 10K resistor (Seeed schematic sheet 03). 120 mA
 *   (1C) is the ceiling.
 * dischg-limit-microamp = 200 mA (1.7C). Seeed's 1000 mA is 8.3C for this cell.
 *   This caps TOTAL battery current, so board + haptic motor/driver peak must
 *   stay under it on battery. MEASURE the haptic draw with the PMIC's own
 *   current reading (status line, mA) when the driver is wired -- do not guess.
 *   Note the header 3V3 pin is a separate DC-DC (U1, 600 mA) fed from VSYS, so
 *   a haptic driver powered from it still draws through this limit.
 *
 * If the cell changes, these two lines must change with it.
 */
&pmic_charger {
	current-microamp = <60000>;
	dischg-limit-microamp = <200000>;
};

/* Watchdog: the board aliases watchdog0 = &wdt31 but leaves the node disabled. */
&wdt31 {
	status = "okay";
};

/ {
	buttons_ext {
		compatible = "gpio-keys";
		userbtn: button_ext_0 {
			gpios = <&gpio1 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "external user button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};
};
