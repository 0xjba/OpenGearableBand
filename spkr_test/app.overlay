/* SD-card WAV player test on XIAO nRF52840 Sense.
 *
 *  I2S -> MAX98357A speaker  (stock Zephyr driver, original pins):
 *    BCLK->D1/P0.03, LRCK->D0/P0.02, DIN->D2/P0.28, amp SD->D7/P1.12 (GPIO).
 *
 *  microSD over SPI (SPIM2 -- NOT SPIM1, which shares the HW block with the
 *  PPG's I2C1; SPIM2 stays conflict-free for the integrated build):
 *    CLK->D8/P1.13, MISO->D9/P1.14, MOSI->D10/P1.15, CS->D3/P0.29.
 */
&pinctrl {
	i2s0_default_alt: i2s0_default_alt {
		group1 {
			psels = <NRF_PSEL(I2S_SCK_M, 0, 3)>,     /* BCLK -> D1/P0.03 */
				<NRF_PSEL(I2S_LRCK_M, 0, 2)>,    /* LRCK -> D0/P0.02 */
				<NRF_PSEL(I2S_SDOUT, 0, 28)>;    /* DIN  -> D2/P0.28 */
		};
	};

	spi2_default_alt: spi2_default_alt {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,     /* CLK  -> D8/P1.13 */
				<NRF_PSEL(SPIM_MOSI, 1, 15)>,    /* MOSI -> D10/P1.15 */
				<NRF_PSEL(SPIM_MISO, 1, 14)>;    /* MISO -> D9/P1.14 */
		};
	};
	spi2_sleep_alt: spi2_sleep_alt {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
				<NRF_PSEL(SPIM_MOSI, 1, 15)>,
				<NRF_PSEL(SPIM_MISO, 1, 14)>;
			low-power-enable;
		};
	};
};

&i2s0 {
	status = "okay";
	pinctrl-0 = <&i2s0_default_alt>;
	pinctrl-names = "default";
};

&spi2 {
	status = "okay";
	pinctrl-0 = <&spi2_default_alt>;
	pinctrl-1 = <&spi2_sleep_alt>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 29 GPIO_ACTIVE_LOW>;   /* CS -> D3/P0.29 */

	sdhc0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <8000000>;        /* [UNIT] 8 MHz -- safe for SPI SD */
		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};
